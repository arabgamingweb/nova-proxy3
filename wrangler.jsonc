{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy3",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "628746e3-66cc-416f-951f-fecaebf80411","database_name": "nova-proxy2" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "93ab0dbbf4bd42e98a17cd5c0b89e16c" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
